/target
**/target
.DS_Store
*.log
*.hprof

# UniFFI-generated language bindings (Swift/Kotlin) -- regenerated from the compiled
# mesh-mobile library, not source of truth.
/bindings/

# iOS app: project.yml is the source of truth; the .xcodeproj is generated by XcodeGen,
# and Frameworks/ + build/ are regenerated by scripts/build-ios.sh.
ios/MeshTalk.xcodeproj/
ios/Frameworks/
ios/build/

# Android app: jniLibs (.so per ABI) and the uniffi/ Kotlin package are regenerated by
# scripts/build-android.sh; build/, .gradle/ are Gradle output; local.properties has
# machine-specific SDK paths.
android/app/src/main/jniLibs/
android/app/src/main/java/uniffi/
android/**/build/
android/.gradle/
android/local.properties
